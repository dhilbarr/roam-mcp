  console.log(`
${colors.bright}🤖 Roam MCP Server Manager${colors.reset}

${colors.green}Usage:${colors.reset}
  roam-mcp ${colors.cyan}<command>${colors.reset}

${colors.green}Commands:${colors.reset}
