async function interactiveMode() {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  function prompt() {
    showStatus();
    console.log(`\n${colors.green}Available actions:${colors.reset}`);
    console.log('  1) Show configuration instructions');
    console.log('  2) Test connection');
    console.log('  3) Setup credentials');
    console.log('  4) Show logs');
    console.log('  5) Refresh status');
    console.log('  q) Quit');
    
    rl.question(`\n${colors.cyan}Select action: ${colors.reset}`, (answer) => {
      console.clear();
      
      switch(answer.trim()) {
        case '1':
          startServer();
          rl.question('\nPress Enter to continue...', () => {
            console.clear();
            prompt();
          });
          break;
        case '2':
          testConnection();
          rl.question('\nPress Enter to continue...', () => {
            console.clear();
            prompt();
          });
          break;
        case '3':
          rl.close();
          setupCredentials();
          break;
        case '4':
          showLogs();
          rl.question('\nPress Enter to continue...', () => {
            console.clear();
            prompt();
          });
          break;
        case '5':
          console.clear();
          prompt();
          break;
        case 'q':
        case 'Q':
          console.log(`\n${colors.green}Goodbye! 👋${colors.reset}`);
          rl.close();
          process.exit(0);
          break;
        default:
          console.log(`${colors.red}Invalid option${colors.reset}`);
          setTimeout(prompt, 1000);
      }
    });
  }

  console.clear();
  console.log(`${colors.bright}🤖 Roam MCP Server Manager${colors.reset}`);
  console.log(`${colors.cyan}Interactive Mode${colors.reset}\n`);
  prompt();
}

// Main execution
const command = process.argv[2];

if (!command) {
  // Interactive mode
  interactiveMode();
} else {
  // Command mode
  switch(command) {
    case 'setup':
      setupCredentials();
      break;
    case 'start':
      startServer();
      break;
    case 'stop':
      stopServer();
      break;
    case 'restart':
      console.log(`${colors.yellow}ℹ️  To restart the MCP server:${colors.reset}`);
      console.log(`${colors.cyan}Restart Claude Desktop${colors.reset}`);
      break;
    case 'status':
      showStatus();
      break;
    case 'test':
      testConnection();
      break;
    case 'logs':
      showLogs();
      break;
    case 'help':
    case '--help':
    case '-h':
      showHelp();
      break;
    default:
      console.log(`${colors.red}Unknown command: ${command}${colors.reset}`);
      console.log(`Use 'roam-mcp help' for usage information`);
      process.exit(1);
  }
}